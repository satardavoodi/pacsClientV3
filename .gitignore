_recovery/

# -- Machine-generated hardware probe (must NEVER ship - would copy the dev box's GPU results) --
config/hardware_check.json

# -- Agent/test scratch output --
.playwright-mcp/
pytest_out.txt
generated-files/*.txt
generated-files/*.log
generated-files/*.err
tools/testing/aipacs_control_mcp/clinical_validation_runs/

# ── Agent Gateway runtime secrets/state (2026-07-19) — MUST NEVER be committed ──
# Machine-generated on first run: TLS private key, channel key, paired-device
# tokens, and a live per-machine config (bind IP, enabled flag). The gateway
# self-seeds these via config_store.py; config_sanitizer blanks them at build.
# Committing gateway_key.pem to a public repo is a security incident.
config/agent_gateway/

# ── Auto-update runtime state (2026-07-19) ──
generated-files/updates/

# ── Scratch audit snapshot (2026-08-02) — full tree copy + tarballs, named for deletion ──
_to_delete/

# ── Re-exclude bytecode under tools/build/ (the !tools/build/** negation from v3.5.4
#    re-included __pycache__; source tooling is tracked, its .pyc cache is not) ──
tools/build/__pycache__/
tools/build/**/*.pyc
