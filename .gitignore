build/
# Exception: tools/build/ holds SOURCE build tooling (lite-viewer build,
# update-manifest generator, update publisher) — not build output. Without
# this negation the generic build/ rule silently untracked all of it.
!tools/build/
!tools/build/**
# Update-publish credentials (website FTP/API) live ONLY on the build machine.
# Commit builder/publish_targets.template.json instead.
builder/publish_targets.json
Pacs.spec
attachment/
source/
dicom.db
cbct-sample/
# SQLite artifacts
**/*.db
**/*.db-shm
**/*.db-wal
backups/
data/
# Exception: modules/*/data/ Python packages are source code, not data directories
!modules/*/data/
!modules/*/data/**
modules/*/data/**/__pycache__/
modules/*/data/**/*.pyc
# Exception: plugin package data/ subpackages are also source code
!builder/plugin package/packages/*/payload/python/modules/*/data/
!builder/plugin package/packages/*/payload/python/modules/*/data/**
builder/plugin package/packages/*/payload/python/modules/*/data/**/__pycache__/
builder/plugin package/packages/*/payload/python/modules/*/data/**/*.pyc
Segments/
dicom.*
*.dcm
*.DCM
*.ipdcom
*.IPdcom
Education/**/CacheFile/
sample_files
