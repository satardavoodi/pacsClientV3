# AI-PACS update service — Apache/WordPress hosting rules.
# Serve blobs and feed correctly; never transparently re-encode .gz blobs.

AddType application/json .json
AddType application/octet-stream .gz
AddType application/octet-stream .exe
AddType text/markdown .md

<IfModule mod_headers.c>
  # Feed must never be cached stale; blobs are content-addressed = immutable.
  <FilesMatch "update_feed\.json$">
    Header set Cache-Control "no-cache, max-age=60"
  </FilesMatch>
  <FilesMatch "\.gz$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# The .gz files are payload, not transport-encoding — disable mod_deflate/brotli
# double-compression and any transparent Content-Encoding tagging.
<IfModule mod_mime.c>
  RemoveEncoding .gz
</IfModule>
SetEnvIfNoCase Request_URI "\.gz$" no-gzip=1 no-brotli=1

Options -Indexes
